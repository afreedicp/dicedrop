<security:ProtectedWindow x:Class="Ludo.Presentation.Wpf.Views.ChatToastWindow"
                          xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                          xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                          xmlns:security="clr-namespace:Ludo.Presentation.Wpf.Security"
                          Title="DiceDrop chat"
                          WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True"
                          ShowActivated="False" SizeToContent="WidthAndHeight" WindowStartupLocation="Manual"
                          Background="{StaticResource Surface}" BorderBrush="{StaticResource Accent}" BorderThickness="1"
                          Cursor="Hand">
    <StackPanel Width="340" Margin="16,12">
        <DockPanel Margin="0,0,0,6">
            <TextBlock DockPanel.Dock="Right" Style="{StaticResource Muted}" Text="click to open" />
            <TextBlock Text="DiceDrop · lobby chat" FontWeight="SemiBold" Foreground="{StaticResource Accent}" />
        </DockPanel>
        <ItemsControl x:Name="Lines">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <TextBlock Margin="0,2" TextWrapping="Wrap" MaxHeight="40" TextTrimming="CharacterEllipsis">
                        <Run Text="{Binding Sender, Mode=OneWay}" FontWeight="SemiBold" /><Run Text=": " /><Run Text="{Binding Text, Mode=OneWay}" />
                    </TextBlock>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </StackPanel>
</security:ProtectedWindow>
