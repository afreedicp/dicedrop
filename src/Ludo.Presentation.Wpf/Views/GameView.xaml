<UserControl x:Class="Ludo.Presentation.Wpf.Views.GameView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:board="clr-namespace:Ludo.Presentation.Wpf.Views.Board">
    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="340" />
        </Grid.ColumnDefinitions>

        <board:BoardCanvas Game="{Binding Game}" MoveCommand="{Binding MoveCommand}" Margin="8" />

        <DockPanel Grid.Column="1">
            <Border DockPanel.Dock="Top" Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource Muted}" Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Status}" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,2,0,0" />
                    <board:DiceView Height="118" Margin="0,6,0,0"
                                    Value="{Binding DiceValue}" RollCount="{Binding RollCount}"
                                    IsRolling="{Binding IsRolling}" IsReady="{Binding CanRoll}"
                                    Tint="{Binding TurnColor}" Command="{Binding RollCommand}" />
                    <TextBlock HorizontalAlignment="Center" Style="{StaticResource Muted}" Text="Click the dice or press Space"
                               Visibility="{Binding CanRoll, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>
            </Border>

            <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Padding="12">
                <ItemsControl ItemsSource="{Binding Seats}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border CornerRadius="6" Padding="8,6" Margin="0,1">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                <Setter Property="Background" Value="{StaticResource SurfaceRaised}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding HasLeft}" Value="True">
                                                <Setter Property="Opacity" Value="0.45" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <DockPanel>
                                    <Ellipse DockPanel.Dock="Left" Width="14" Height="14" Fill="{Binding Color}" Margin="0,0,10,0" />
                                    <TextBlock DockPanel.Dock="Right" Style="{StaticResource Muted}" Text="{Binding Detail}" />
                                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                </DockPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>

            <Border DockPanel.Dock="Top" Style="{StaticResource Card}" BorderBrush="{StaticResource Accent}"
                    Visibility="{Binding IsOver, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <TextBlock Style="{StaticResource Heading}" Text="{Binding Outcome}" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding Ranking}" FontSize="15" />
                </StackPanel>
            </Border>

            <WrapPanel DockPanel.Dock="Bottom" Margin="4,4,4,0" HorizontalAlignment="Right">
                <Button Style="{StaticResource SecondaryButton}" Content="Leave game" Margin="4"
                        Command="{Binding LeaveCommand}"
                        Visibility="{Binding CanLeave, Converter={StaticResource BoolToVisibility}}" />
                <Button Style="{StaticResource SecondaryButton}" Content="Stop game" Margin="4"
                        Command="{Binding StopCommand}"
                        Visibility="{Binding CanStop, Converter={StaticResource BoolToVisibility}}" />
                <Button Content="Back to lobby" Margin="4" Command="{Binding BackCommand}" />
            </WrapPanel>

            <!-- Lobby chat keeps going during the game; the latest moves sit above it. -->
            <Border Style="{StaticResource Card}" Padding="14">
                <DockPanel>
                    <ItemsControl DockPanel.Dock="Top" ItemsSource="{Binding Log}" Margin="0,0,0,8" MaxHeight="58" ClipToBounds="True">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" Style="{StaticResource Muted}" TextTrimming="CharacterEllipsis" FontSize="12" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <DockPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                        <Button DockPanel.Dock="Right" Content="Send" Margin="6,0,0,0" Padding="12,6"
                                Command="{Binding Lobby.SendChatCommand}" />
                        <TextBox Margin="0" VerticalContentAlignment="Center"
                                 MaxLength="{Binding Lobby.MaxChatLength, Mode=OneTime}"
                                 Text="{Binding Lobby.ChatDraft, UpdateSourceTrigger=PropertyChanged}">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Enter" Command="{Binding Lobby.SendChatCommand}" />
                            </TextBox.InputBindings>
                        </TextBox>
                    </DockPanel>

                    <ScrollViewer x:Name="ChatScroller" VerticalScrollBarVisibility="Auto" ScrollChanged="OnChatScrollChanged">
                        <ItemsControl ItemsSource="{Binding Lobby.Chat}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock TextWrapping="Wrap" Margin="0,2" FontSize="13">
                                        <Run Text="{Binding Sender, Mode=OneWay}" FontWeight="SemiBold" Foreground="{StaticResource Accent}" />
                                        <Run Text="{Binding Text, Mode=OneWay}" />
                                    </TextBlock>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </DockPanel>
    </Grid>
</UserControl>
