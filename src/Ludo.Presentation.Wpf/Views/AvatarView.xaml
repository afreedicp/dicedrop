<UserControl x:Class="Ludo.Presentation.Wpf.Views.AvatarView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root" Focusable="False" IsTabStop="False">
    <!-- A photo when there is one, else initials on the person's colour, with an optional presence dot. -->
    <Grid Width="{Binding Size, ElementName=Root}" Height="{Binding Size, ElementName=Root}">
        <Ellipse Fill="{Binding Fill, ElementName=Root}" />
        <TextBlock x:Name="Letters" Text="{Binding Initials, ElementName=Root}" Foreground="White" FontWeight="Bold"
                   HorizontalAlignment="Center" VerticalAlignment="Center" />
        <Ellipse>
            <Ellipse.Fill>
                <ImageBrush ImageSource="{Binding Photo, ElementName=Root}" Stretch="UniformToFill" />
            </Ellipse.Fill>
        </Ellipse>
        <Ellipse x:Name="Dot" HorizontalAlignment="Right" VerticalAlignment="Bottom" Stroke="{StaticResource Surface}"
                 StrokeThickness="2" Fill="{Binding Presence, ElementName=Root}" Visibility="Collapsed" />
    </Grid>
</UserControl>
