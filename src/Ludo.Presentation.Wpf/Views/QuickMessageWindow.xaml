<security:ProtectedWindow x:Class="Ludo.Presentation.Wpf.Views.QuickMessageWindow"
                          xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                          xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                          xmlns:security="clr-namespace:Ludo.Presentation.Wpf.Security"
                          xmlns:views="clr-namespace:Ludo.Presentation.Wpf.Views"
                          Title="DiceDrop · send a message"
                          WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True"
                          SizeToContent="Height" Width="380" WindowStartupLocation="Manual"
                          Background="{StaticResource Surface}" BorderBrush="{StaticResource Border}" BorderThickness="1">
    <!-- Opened from the tray: pick the lobby or a person, type, and send without opening the main window. -->
    <security:ProtectedWindow.InputBindings>
        <KeyBinding Key="Escape" Command="{Binding CloseCommand}" />
    </security:ProtectedWindow.InputBindings>

    <DockPanel x:Name="Body">
        <Border DockPanel.Dock="Top" Height="3" Background="{StaticResource Accent}" />
        <StackPanel Margin="16,12,16,16">
            <DockPanel Margin="0,0,0,10">
                <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Padding="6" Command="{Binding CloseCommand}"
                        AutomationProperties.Name="Close">
                    <Path Width="12" Height="12" Stretch="Uniform" Data="{StaticResource CloseIcon}"
                          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                </Button>
                <TextBlock Text="Send a message" FontWeight="SemiBold" FontSize="15" VerticalAlignment="Center" />
            </DockPanel>

            <TextBlock Style="{StaticResource Muted}" FontSize="12" Text="DiceDrop is still looking for a lobby."
                       Visibility="{Binding HasTargets, Converter={StaticResource InverseBoolToVisibility}}" />

            <!-- Recipients: the lobby, then everyone present. -->
            <ItemsControl ItemsSource="{Binding Targets}" Margin="0,0,0,10">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Margin="0,0,6,6" Cursor="Hand" FocusVisualStyle="{x:Null}"
                                Command="{Binding DataContext.PickCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="{Binding}">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Chip" CornerRadius="16" Padding="4,4,12,4" Background="{StaticResource SurfaceRaised}"
                                            BorderBrush="{StaticResource Border}" BorderThickness="1">
                                        <StackPanel Orientation="Horizontal">
                                            <Grid Margin="0,0,7,0">
                                                <views:AvatarView Person="{Binding Person}" Size="22"
                                                                  Visibility="{Binding IsLobby, Converter={StaticResource InverseBoolToVisibility}}" />
                                                <Grid Width="22" Height="22" Visibility="{Binding IsLobby, Converter={StaticResource BoolToVisibility}}">
                                                    <Ellipse Fill="{StaticResource AccentSoft}" />
                                                    <Path Width="12" Height="12" Stretch="Uniform" Fill="{StaticResource Accent}" Data="{StaticResource GroupIcon}" />
                                                </Grid>
                                            </Grid>
                                            <TextBlock x:Name="Label" FontSize="13" VerticalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                                        <Setter Property="Text" Value="{Binding Person.Name}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsLobby}" Value="True">
                                                                <Setter Property="Text" Value="Lobby" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Chip" Property="BorderBrush" Value="{StaticResource TextFaint}" />
                                        </Trigger>
                                        <DataTrigger Value="True">
                                            <DataTrigger.Binding>
                                                <MultiBinding Converter="{x:Static views:EqualityConverter.Instance}">
                                                    <Binding />
                                                    <Binding Path="DataContext.Target" RelativeSource="{RelativeSource AncestorType=Window}" />
                                                </MultiBinding>
                                            </DataTrigger.Binding>
                                            <Setter TargetName="Chip" Property="Background" Value="{StaticResource AccentSoft}" />
                                            <Setter TargetName="Chip" Property="BorderBrush" Value="{StaticResource Accent}" />
                                        </DataTrigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Border Padding="4" CornerRadius="24" Background="{StaticResource SurfaceRaised}" BorderBrush="{StaticResource Border}" BorderThickness="1">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Command="{Binding SendCommand}" AutomationProperties.Name="Send">
                        <Path Width="16" Height="16" Stretch="Uniform" Margin="2,0,0,0"
                              Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              Data="M2,21 L23,12 L2,3 L2,10 L17,12 L2,14 Z" />
                    </Button>
                    <TextBox x:Name="Composer" Margin="0" BorderThickness="0" Background="Transparent" Padding="14,0"
                             VerticalContentAlignment="Center" Tag="{Binding Placeholder}"
                             MaxLength="{Binding MaxChatLength, Mode=OneTime}"
                             Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Enter" Command="{Binding SendCommand}" />
                        </TextBox.InputBindings>
                    </TextBox>
                </DockPanel>
            </Border>
        </StackPanel>
    </DockPanel>
</security:ProtectedWindow>
