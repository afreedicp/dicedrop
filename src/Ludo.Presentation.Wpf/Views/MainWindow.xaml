<security:ProtectedWindow x:Class="Ludo.Presentation.Wpf.Views.MainWindow"
                          xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                          xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                          xmlns:security="clr-namespace:Ludo.Presentation.Wpf.Security"
                          xmlns:vm="clr-namespace:Ludo.Presentation.Wpf.ViewModels"
                          xmlns:views="clr-namespace:Ludo.Presentation.Wpf.Views"
                          Title="DiceDrop"
                          Width="1260" Height="820" MinWidth="980" MinHeight="640"
                          WindowStartupLocation="CenterScreen"
                          Background="{StaticResource Background}">
    <security:ProtectedWindow.Resources>
        <DataTemplate DataType="{x:Type vm:SearchingViewModel}">
            <views:SearchingView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:LobbyViewModel}">
            <views:LobbyView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:GameViewModel}">
            <views:GameView />
        </DataTemplate>
    </security:ProtectedWindow.Resources>

    <security:ProtectedWindow.InputBindings>
        <KeyBinding Key="F12" Command="{Binding Diagnostics.ToggleCommand}" />
    </security:ProtectedWindow.InputBindings>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Each new screen fades in and settles into place. -->
        <ContentControl Content="{Binding CurrentScreen, NotifyOnTargetUpdated=True}" Focusable="False">
            <ContentControl.RenderTransform>
                <TranslateTransform />
            </ContentControl.RenderTransform>
            <ContentControl.Triggers>
                <EventTrigger RoutedEvent="Binding.TargetUpdated">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.3" />
                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.Y" From="14" To="0" Duration="0:0:0.35">
                                <DoubleAnimation.EasingFunction>
                                    <CubicEase EasingMode="EaseOut" />
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </ContentControl.Triggers>
        </ContentControl>

        <!-- Network log, inside this window so it is capture-protected like everything else. F12 toggles it. -->
        <Border Grid.Row="1" Height="260" Background="{StaticResource Surface}" BorderBrush="{StaticResource Border}"
                BorderThickness="0,1,0,0" Padding="12,8"
                Visibility="{Binding Diagnostics.IsOpen, Converter={StaticResource BoolToVisibility}}">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                    <Button DockPanel.Dock="Right" Style="{StaticResource SecondaryButton}" Content="Close" Padding="10,3"
                            FontSize="12" Margin="6,0,0,0" Command="{Binding Diagnostics.ToggleCommand}" />
                    <Button DockPanel.Dock="Right" Style="{StaticResource SecondaryButton}" Content="Clear" Padding="10,3"
                            FontSize="12" Margin="6,0,0,0" Command="{Binding Diagnostics.ClearCommand}" />
                    <Button DockPanel.Dock="Right" Style="{StaticResource SecondaryButton}" Content="Copy all" Padding="10,3"
                            FontSize="12" Command="{Binding Diagnostics.CopyCommand}" />
                    <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="Network log" />
                    <TextBlock VerticalAlignment="Center" Style="{StaticResource Muted}" Margin="12,0,0,0" TextTrimming="CharacterEllipsis"
                               Text="Open it on both PCs: lines marked PROBLEM, or 'heard only our own beacons', say what blocks the connection." />
                </DockPanel>
                <ListBox x:Name="DiagnosticLines" ItemsSource="{Binding Diagnostics.Lines}" Background="{StaticResource Background}"
                         BorderBrush="{StaticResource Border}" Foreground="{StaticResource Text}" FontFamily="Consolas" FontSize="12"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.ScrollUnit="Pixel">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" FontFamily="Consolas" FontSize="12" TextWrapping="Wrap" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- Footer tools, bottom left: hidden while the network log is open. -->
        <StackPanel VerticalAlignment="Bottom" HorizontalAlignment="Left" Margin="6" Orientation="Horizontal" Opacity="0.8">
            <StackPanel.Style>
                <Style TargetType="StackPanel">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Diagnostics.IsOpen}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </StackPanel.Style>
            <Button Style="{StaticResource SecondaryButton}" Padding="10,3" FontSize="12"
                    Content="Network log (F12)" Command="{Binding Diagnostics.ToggleCommand}" />
            <!-- GitHub mark: opens the source code. Named for screen readers, since tooltips are suppressed app-wide. -->
            <Button Margin="8,0,0,0" VerticalAlignment="Center" Cursor="Hand" AutomationProperties.Name="Source code on GitHub"
                    Command="{Binding OpenSourceCodeCommand}">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent" Padding="2">
                            <Path x:Name="Mark" Width="20" Height="20" Stretch="Uniform" Fill="{StaticResource TextMuted}"
                                  Data="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0 0 16 8c0-4.42-3.58-8-8-8z" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Mark" Property="Fill" Value="{StaticResource Text}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Mark" Property="Opacity" Value="0.75" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </StackPanel>

        <!-- Update banner: a newer release is out. Clicking it opens the release page in the browser. -->
        <Border VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="8" Padding="4" CornerRadius="14"
                Background="{StaticResource Surface}" BorderBrush="{StaticResource Accent}" BorderThickness="1"
                Effect="{StaticResource FloatingShadow}" views:Motion.Enter="True" views:Motion.EnterOffset="20"
                Visibility="{Binding Update.IsVisible, Converter={StaticResource BoolToVisibility}}">
            <StackPanel Orientation="Horizontal">
                <Button Padding="12,5" FontSize="12" Command="{Binding Update.OpenCommand}">
                    <TextBlock Foreground="{StaticResource AccentText}" FontSize="12">
                        <Run Text="Update available:" />
                        <Run Text="{Binding Update.LatestTag, Mode=OneWay}" FontWeight="Bold" />
                        <Run Text="{Binding Update.CurrentVersion, StringFormat=(you have {0}), Mode=OneWay}" FontWeight="Normal" />
                        <Run Text="· Download" />
                    </TextBlock>
                </Button>
                <Button Style="{StaticResource SecondaryButton}" Content="✕" Padding="8,4" FontSize="11" Margin="4,0,0,0"
                        Command="{Binding Update.DismissCommand}" />
            </StackPanel>
        </Border>

        <!-- Settings sheet over everything else. -->
        <views:SettingsView Grid.RowSpan="2" DataContext="{Binding Settings}"
                            Visibility="{Binding IsOpen, Converter={StaticResource BoolToVisibility}}" />

        <!-- In-window notice instead of a MessageBox: a separate window would be one more thing to protect. -->
        <Border Grid.RowSpan="2" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,16,0,0" Padding="16,10"
                CornerRadius="14" Background="#2E2819" BorderBrush="{StaticResource Accent}" BorderThickness="1"
                Effect="{StaticResource FloatingShadow}" views:Motion.Enter="True" views:Motion.EnterOffset="-16"
                MaxWidth="640">
            <Border.Style>
                <Style TargetType="Border">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Notice}" Value="{x:Null}">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="OK" Margin="16,0,0,0" Padding="12,4"
                        Command="{Binding DismissNoticeCommand}" />
                <TextBlock Text="{Binding Notice}" TextWrapping="Wrap" VerticalAlignment="Center" />
            </DockPanel>
        </Border>
    </Grid>
</security:ProtectedWindow>
