<security:ProtectedWindow x:Class="Ludo.Presentation.Wpf.Views.MainWindow"
                          xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                          xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                          xmlns:security="clr-namespace:Ludo.Presentation.Wpf.Security"
                          xmlns:vm="clr-namespace:Ludo.Presentation.Wpf.ViewModels"
                          xmlns:views="clr-namespace:Ludo.Presentation.Wpf.Views"
                          Title="DiceDrop"
                          Width="1180" Height="800" MinWidth="900" MinHeight="640"
                          WindowStartupLocation="CenterScreen"
                          Background="{StaticResource Background}">
    <security:ProtectedWindow.Resources>
        <DataTemplate DataType="{x:Type vm:SearchingViewModel}">
            <views:SearchingView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:LobbyViewModel}">
            <views:LobbyView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:GameViewModel}">
            <views:GameView />
        </DataTemplate>
    </security:ProtectedWindow.Resources>

    <security:ProtectedWindow.InputBindings>
        <KeyBinding Key="F12" Command="{Binding Diagnostics.ToggleCommand}" />
    </security:ProtectedWindow.InputBindings>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ContentControl Content="{Binding CurrentScreen}" Focusable="False" />

        <!-- Network log, inside this window so it is capture-protected like everything else. F12 toggles it. -->
        <Border Grid.Row="1" Height="260" Background="{StaticResource Surface}" BorderBrush="{StaticResource Border}"
                BorderThickness="0,1,0,0" Padding="12,8"
                Visibility="{Binding Diagnostics.IsOpen, Converter={StaticResource BoolToVisibility}}">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                    <Button DockPanel.Dock="Right" Style="{StaticResource SecondaryButton}" Content="Close" Padding="10,3"
                            FontSize="12" Margin="6,0,0,0" Command="{Binding Diagnostics.ToggleCommand}" />
                    <Button DockPanel.Dock="Right" Style="{StaticResource SecondaryButton}" Content="Clear" Padding="10,3"
                            FontSize="12" Margin="6,0,0,0" Command="{Binding Diagnostics.ClearCommand}" />
                    <Button DockPanel.Dock="Right" Style="{StaticResource SecondaryButton}" Content="Copy all" Padding="10,3"
                            FontSize="12" Command="{Binding Diagnostics.CopyCommand}" />
                    <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="Network log" />
                    <TextBlock VerticalAlignment="Center" Style="{StaticResource Muted}" Margin="12,0,0,0" TextTrimming="CharacterEllipsis"
                               Text="Open it on both PCs: lines marked PROBLEM, or 'heard only our own beacons', say what blocks the connection." />
                </DockPanel>
                <ListBox x:Name="DiagnosticLines" ItemsSource="{Binding Diagnostics.Lines}" Background="{StaticResource Background}"
                         BorderBrush="{StaticResource Border}" Foreground="{StaticResource Text}" FontFamily="Consolas" FontSize="12"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.ScrollUnit="Pixel">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" FontFamily="Consolas" FontSize="12" TextWrapping="Wrap" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <Button VerticalAlignment="Bottom" HorizontalAlignment="Left" Margin="6" Padding="10,3" FontSize="12"
                Content="Network log (F12)" Opacity="0.8" Command="{Binding Diagnostics.ToggleCommand}">
            <Button.Style>
                <Style TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Diagnostics.IsOpen}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Button.Style>
        </Button>

        <!-- In-window notice instead of a MessageBox: a separate window would be one more thing to protect. -->
        <Border Grid.RowSpan="2" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,16,0,0" Padding="16,10"
                CornerRadius="8" Background="#3B2F1A" BorderBrush="{StaticResource Accent}" BorderThickness="1"
                MaxWidth="640">
            <Border.Style>
                <Style TargetType="Border">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Notice}" Value="{x:Null}">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="OK" Margin="16,0,0,0" Padding="12,4"
                        Command="{Binding DismissNoticeCommand}" />
                <TextBlock Text="{Binding Notice}" TextWrapping="Wrap" VerticalAlignment="Center" />
            </DockPanel>
        </Border>
    </Grid>
</security:ProtectedWindow>
