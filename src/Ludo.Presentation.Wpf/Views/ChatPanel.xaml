<UserControl x:Class="Ludo.Presentation.Wpf.Views.ChatPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:Ludo.Presentation.Wpf.Views">
    <!-- Lobby chat as message bubbles. DataContext is the LobbyViewModel; the lobby and the game screen both host it. -->
    <UserControl.Resources>
        <!-- Other players: avatar and name on the first line of a run, bubbles on the left. -->
        <DataTemplate x:Key="OtherMessage">
            <Grid views:Motion.Enter="True" views:Motion.EnterOffset="8" Margin="0,2,44,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="40" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding StartsGroup}" Value="True">
                                <Setter Property="Margin" Value="0,12,44,0" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>

                <Grid Width="30" Height="30" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="0,18,0,0"
                      Visibility="{Binding StartsGroup, Converter={StaticResource BoolToVisibility}}">
                    <Ellipse Fill="{Binding AvatarColor}" />
                    <TextBlock Text="{Binding Initials}" FontSize="11" FontWeight="Bold" Foreground="White"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Grid>

                <StackPanel Grid.Column="1">
                    <TextBlock Margin="2,0,0,3" Visibility="{Binding StartsGroup, Converter={StaticResource BoolToVisibility}}">
                        <Run Text="{Binding Sender, Mode=OneWay}" FontWeight="SemiBold" FontSize="12" />
                        <Run Text="{Binding TimeLabel, Mode=OneWay}" FontSize="11" Foreground="{StaticResource TextFaint}" />
                    </TextBlock>
                    <Border HorizontalAlignment="Left" Background="{StaticResource SurfaceRaised}" Padding="12,7">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="14" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding StartsGroup}" Value="True">
                                        <Setter Property="CornerRadius" Value="4,14,14,14" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="{Binding Text}" TextWrapping="Wrap" LineHeight="19" />
                    </Border>
                </StackPanel>
            </Grid>
        </DataTemplate>

        <!-- Our own lines: accent bubbles on the right, no avatar. -->
        <DataTemplate x:Key="LocalMessage">
            <StackPanel views:Motion.Enter="True" views:Motion.EnterOffset="8" Margin="56,2,0,0">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding StartsGroup}" Value="True">
                                <Setter Property="Margin" Value="56,12,0,0" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <TextBlock HorizontalAlignment="Right" Margin="0,0,2,3" FontSize="11" Foreground="{StaticResource TextFaint}"
                           Text="{Binding TimeLabel, StringFormat='You · {0}'}"
                           Visibility="{Binding StartsGroup, Converter={StaticResource BoolToVisibility}}" />
                <Border HorizontalAlignment="Right" Background="{StaticResource Accent}" Padding="12,7">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="14" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding StartsGroup}" Value="True">
                                    <Setter Property="CornerRadius" Value="14,4,14,14" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Text="{Binding Text}" TextWrapping="Wrap" LineHeight="19" Foreground="{StaticResource AccentText}" />
                </Border>
            </StackPanel>
        </DataTemplate>

        <views:ChatTemplateSelector x:Key="MessageTemplates"
                                    LocalTemplate="{StaticResource LocalMessage}"
                                    OtherTemplate="{StaticResource OtherMessage}" />
    </UserControl.Resources>

    <DockPanel>
        <!-- Composer: placeholder, a character count near the limit, and a round send button. Enter sends. -->
        <Border DockPanel.Dock="Bottom" Margin="0,10,0,0" Padding="4" CornerRadius="24" Background="{StaticResource SurfaceSunken}"
                BorderBrush="{StaticResource Border}" BorderThickness="1">
            <DockPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Command="{Binding SendChatCommand}"
                        AutomationProperties.Name="Send message">
                    <Path Width="16" Height="16" Stretch="Uniform" Margin="2,0,0,0"
                          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                          Data="M2,21 L23,12 L2,3 L2,10 L17,12 L2,14 Z" />
                </Button>
                <TextBlock x:Name="Counter" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="6,0,8,0" FontSize="11"
                           Foreground="{StaticResource TextFaint}" Visibility="Collapsed" />
                <TextBox x:Name="Composer" Margin="0" BorderThickness="0" Background="Transparent" Padding="12,0"
                         VerticalContentAlignment="Center" Tag="Message the lobby…"
                         MaxLength="{Binding MaxChatLength, Mode=OneTime}"
                         Text="{Binding ChatDraft, UpdateSourceTrigger=PropertyChanged}"
                         TextChanged="OnComposerTextChanged">
                    <TextBox.InputBindings>
                        <KeyBinding Key="Enter" Command="{Binding SendChatCommand}" />
                    </TextBox.InputBindings>
                </TextBox>
            </DockPanel>
        </Border>

        <Grid>
            <!-- Empty state. -->
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" views:Motion.Enter="True">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Chat.Count}" Value="0">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <Grid Width="56" Height="56" HorizontalAlignment="Center">
                    <Ellipse Fill="{StaticResource AccentSoft}" />
                    <Path Width="26" Height="26" Stretch="Uniform" Fill="{StaticResource Accent}"
                          Data="M4,3 H20 A2,2 0 0 1 22,5 V15 A2,2 0 0 1 20,17 H8 L3,21 V17 A2,2 0 0 1 2,15 V5 A2,2 0 0 1 4,3 Z" />
                </Grid>
                <TextBlock Text="No messages yet" HorizontalAlignment="Center" FontWeight="SemiBold" Margin="0,12,0,2" />
                <TextBlock Style="{StaticResource Muted}" Text="Say hi to everyone in the lobby." HorizontalAlignment="Center" />
            </StackPanel>

            <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto" ScrollChanged="OnScrollChanged" Padding="0,0,4,4">
                <ItemsControl ItemsSource="{Binding Chat}" ItemTemplateSelector="{StaticResource MessageTemplates}" />
            </ScrollViewer>

            <!-- Shown when lines arrive while scrolled up to read older ones. -->
            <Button x:Name="NewMessages" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,8"
                    Padding="14,6" FontSize="12" Visibility="Collapsed" views:Motion.Enter="True" views:Motion.EnterOffset="12"
                    Click="OnNewMessagesClick">
                <Button.Effect>
                    <DropShadowEffect BlurRadius="14" ShadowDepth="3" Direction="270" Opacity="0.5" Color="Black" />
                </Button.Effect>
                <TextBlock Foreground="{StaticResource AccentText}" FontSize="12" FontWeight="SemiBold" Text="New messages  ↓" />
            </Button>
        </Grid>
    </DockPanel>
</UserControl>
