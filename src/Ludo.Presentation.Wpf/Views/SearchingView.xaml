<UserControl x:Class="Ludo.Presentation.Wpf.Views.SearchingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:Ludo.Presentation.Wpf.Views">
    <UserControl.Resources>
        <!-- One sonar ring: grows from the dice and fades out. -->
        <Style x:Key="Ring" TargetType="Ellipse">
            <Setter Property="Width" Value="220" />
            <Setter Property="Height" Value="220" />
            <Setter Property="Stroke" Value="{StaticResource Accent}" />
            <Setter Property="StrokeThickness" Value="1.5" />
            <Setter Property="Opacity" Value="0" />
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <ScaleTransform ScaleX="0.3" ScaleY="0.3" />
                </Setter.Value>
            </Setter>
        </Style>
        <Storyboard x:Key="Sonar" RepeatBehavior="Forever" Duration="0:0:2.4">
            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX" From="0.3" To="1" Duration="0:0:2.4">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY" From="0.3" To="1" Duration="0:0:2.4">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.7" To="0" Duration="0:0:2.4" />
        </Storyboard>
    </UserControl.Resources>

    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="560" views:Motion.Enter="True" views:Motion.EnterOffset="16">
        <Grid Width="220" Height="220" HorizontalAlignment="Center">
            <Ellipse x:Name="Ring0" Style="{StaticResource Ring}" />
            <Ellipse x:Name="Ring1" Style="{StaticResource Ring}" />
            <Ellipse x:Name="Ring2" Style="{StaticResource Ring}" />

            <!-- The dice rocks gently and bobs while we listen for lobbies. -->
            <Grid Width="72" Height="72" RenderTransformOrigin="0.5,0.5">
                <Grid.RenderTransform>
                    <TransformGroup>
                        <RotateTransform />
                        <TranslateTransform />
                    </TransformGroup>
                </Grid.RenderTransform>
                <Grid.Effect>
                    <DropShadowEffect BlurRadius="30" ShadowDepth="0" Opacity="0.55" Color="{StaticResource AccentColor}" />
                </Grid.Effect>
                <Grid.Triggers>
                    <EventTrigger RoutedEvent="Loaded">
                        <BeginStoryboard>
                            <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.Children[0].Angle" From="-8" To="8" Duration="0:0:1.4">
                                    <DoubleAnimation.EasingFunction>
                                        <SineEase EasingMode="EaseInOut" />
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.Children[1].Y" From="3" To="-5" Duration="0:0:0.7"
                                                 AutoReverse="True">
                                    <DoubleAnimation.EasingFunction>
                                        <SineEase EasingMode="EaseInOut" />
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                </Grid.Triggers>
                <Rectangle RadiusX="16" RadiusY="16">
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#FFD978" Offset="0" />
                            <GradientStop Color="#F5B52E" Offset="1" />
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>
                <UniformGrid Rows="3" Columns="3" Margin="12">
                    <Ellipse Width="11" Height="11" Fill="{StaticResource AccentText}" />
                    <Ellipse />
                    <Ellipse Width="11" Height="11" Fill="{StaticResource AccentText}" />
                    <Ellipse />
                    <Ellipse Width="11" Height="11" Fill="{StaticResource AccentText}" />
                    <Ellipse />
                    <Ellipse Width="11" Height="11" Fill="{StaticResource AccentText}" />
                    <Ellipse />
                    <Ellipse Width="11" Height="11" Fill="{StaticResource AccentText}" />
                </UniformGrid>
            </Grid>
        </Grid>

        <TextBlock Text="DiceDrop" FontSize="34" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,8,0,0" />
        <TextBlock Style="{StaticResource Muted}" FontSize="15" Margin="0,4,0,24" HorizontalAlignment="Center"
                   Text="Serverless Ludo for 2 to 8 players. Every peer checks every move, and nobody can rig the dice."
                   TextWrapping="Wrap" TextAlignment="Center" />
        <Border Style="{StaticResource Card}">
            <StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,8">
                    <Ellipse Width="8" Height="8" Fill="{StaticResource Accent}" Margin="0,2,10,0" VerticalAlignment="Center"
                             views:Motion.Pulse="True" />
                    <TextBlock Style="{StaticResource Heading}" Text="Finding players on your network…" Margin="0" />
                </StackPanel>
                <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" TextAlignment="Center">
                    <Run Text="Playing as " /><Run Text="{Binding PlayerName, Mode=OneWay}" FontWeight="SemiBold" Foreground="{StaticResource Text}" /><Run Text=". You will join the lobby on this network, or open one if there is none yet." />
                </TextBlock>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
