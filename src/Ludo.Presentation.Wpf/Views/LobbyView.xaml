<UserControl x:Class="Ludo.Presentation.Wpf.Views.LobbyView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="HiddenWhileRenaming" TargetType="FrameworkElement">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsRenaming}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid MaxWidth="1100" Margin="24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3*" />
            <ColumnDefinition Width="2*" MinWidth="300" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Margin="8,8,8,8">
            <TextBlock Text="Lobby" FontSize="30" FontWeight="Bold" />
            <TextBlock Style="{StaticResource Muted}" Text="{Binding Status}" />
        </StackPanel>

        <!-- Rename: inline editor instead of a dialog, so no extra window needs protecting. -->
        <Grid Grid.Column="1" Margin="8" VerticalAlignment="Center">
            <DockPanel Style="{StaticResource HiddenWhileRenaming}">
                <Button DockPanel.Dock="Right" Style="{StaticResource SecondaryButton}" Content="Rename"
                        Command="{Binding RenameCommand}" />
                <TextBlock VerticalAlignment="Center" Margin="0,0,12,0" TextTrimming="CharacterEllipsis">
                    <Run Text="Playing as" Foreground="{StaticResource TextMuted}" />
                    <Run Text="{Binding LocalName, Mode=OneWay}" FontWeight="SemiBold" />
                </TextBlock>
            </DockPanel>
            <DockPanel Visibility="{Binding IsRenaming, Converter={StaticResource BoolToVisibility}}">
                <Button DockPanel.Dock="Right" Style="{StaticResource SecondaryButton}" Content="Cancel" Margin="6,0,0,0"
                        Command="{Binding CancelRenameCommand}" />
                <Button DockPanel.Dock="Right" Content="Save" Margin="8,0,0,0" Command="{Binding SaveNameCommand}" />
                <TextBox x:Name="NameBox" Margin="0" VerticalContentAlignment="Center"
                         MaxLength="{Binding MaxNameLength, Mode=OneTime}"
                         Text="{Binding NameDraft, UpdateSourceTrigger=PropertyChanged}"
                         IsVisibleChanged="OnNameBoxVisibleChanged">
                    <TextBox.InputBindings>
                        <KeyBinding Key="Enter" Command="{Binding SaveNameCommand}" />
                        <KeyBinding Key="Escape" Command="{Binding CancelRenameCommand}" />
                    </TextBox.InputBindings>
                </TextBox>
            </DockPanel>
        </Grid>

        <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Style="{StaticResource Muted}" Margin="8,0,8,8" TextWrapping="Wrap"
                   Text="Everyone who opens DiceDrop on this network lands here automatically. Allow DiceDrop through Windows Firewall when asked." />

        <DockPanel Grid.Row="2">
        <!-- Anyone can start a game here; the card follows the invite from question to running game. -->
        <Border DockPanel.Dock="Top">
            <Border.Style>
                <Style TargetType="Border" BasedOn="{StaticResource Card}">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsInvitedNow}" Value="True">
                            <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
                            <Setter Property="BorderThickness" Value="2" />
                            <Setter Property="Background" Value="#2E2A1E" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <StackPanel>
                <TextBlock Style="{StaticResource Heading}" Text="{Binding GameTitle}" Margin="0,0,0,4" TextWrapping="Wrap" />
                <TextBlock Style="{StaticResource Muted}" Text="{Binding GameDetail}" TextWrapping="Wrap" />

                <ItemsControl ItemsSource="{Binding Invitees}" Margin="0,10,0,0">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{StaticResource SurfaceRaised}" CornerRadius="12" Padding="10,4" Margin="0,0,6,6">
                                <TextBlock FontSize="13">
                                    <Run Text="{Binding Name, Mode=OneWay}" />
                                    <Run Text="{Binding Answer, Mode=OneWay}">
                                        <Run.Style>
                                            <Style TargetType="Run">
                                                <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsIn}" Value="True">
                                                        <Setter Property="Foreground" Value="#7BD88F" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Run.Style>
                                    </Run>
                                </TextBlock>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <WrapPanel Margin="-4,8,0,0">
                    <Button Margin="4" Content="Start a game" Command="{Binding ProposeCommand}"
                            Visibility="{Binding ShowPropose, Converter={StaticResource BoolToVisibility}}" />
                    <Button Margin="4" Content="{Binding BeginLabel}" Command="{Binding BeginCommand}"
                            Visibility="{Binding ShowBegin, Converter={StaticResource BoolToVisibility}}" />
                    <Button Margin="4" Content="Join game" Command="{Binding AcceptCommand}"
                            Visibility="{Binding ShowAccept, Converter={StaticResource BoolToVisibility}}" />
                    <Button Margin="4" Style="{StaticResource SecondaryButton}" Content="Not now" Command="{Binding DeclineCommand}"
                            Visibility="{Binding IsInvitedNow, Converter={StaticResource BoolToVisibility}}" />
                    <Button Margin="4" Style="{StaticResource SecondaryButton}" Content="Back out" Command="{Binding DeclineCommand}"
                            Visibility="{Binding ShowDecline, Converter={StaticResource BoolToVisibility}}" />
                    <Button Margin="4" Content="{Binding WatchLabel}" Command="{Binding WatchCommand}"
                            Visibility="{Binding ShowWatch, Converter={StaticResource BoolToVisibility}}" />
                    <Button Margin="4" Style="{StaticResource SecondaryButton}" Content="Cancel invite" Command="{Binding StopCommand}"
                            Visibility="{Binding ShowCancel, Converter={StaticResource BoolToVisibility}}" />
                    <Button Margin="4" Style="{StaticResource SecondaryButton}" Content="Stop game" Command="{Binding StopCommand}"
                            Visibility="{Binding ShowStop, Converter={StaticResource BoolToVisibility}}" />
                </WrapPanel>
            </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Style="{StaticResource Heading}" Text="Players" />
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Members}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource SurfaceRaised}" CornerRadius="8" Padding="12,10" Margin="0,4">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Right" VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource Muted}">
                                                    <Setter Property="Text" Value="Connecting…" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsReady}" Value="True">
                                                            <Setter Property="Text" Value="Ready" />
                                                            <Setter Property="Foreground" Value="#7BD88F" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock VerticalAlignment="Center" Text="{Binding Name}" FontWeight="SemiBold" />
                                        <TextBlock Margin="10,0,0,0" VerticalAlignment="Center" Style="{StaticResource Muted}" Text="{Binding Tags}" />
                                        <Border Margin="10,0,0,0" Padding="8,1" CornerRadius="9" Background="#24452E" VerticalAlignment="Center"
                                                HorizontalAlignment="Left"
                                                Visibility="{Binding InGame, Converter={StaticResource BoolToVisibility}}">
                                            <TextBlock Text="in game" FontSize="12" Foreground="#7BD88F" />
                                        </Border>
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>
        </DockPanel>

        <Border Grid.Row="2" Grid.Column="1" Style="{StaticResource Card}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                    <TextBlock Style="{StaticResource Heading}" Text="Chat" Margin="0" />
                    <TextBlock Style="{StaticResource Muted}" Text="Everyone in the lobby sees this. Nothing is saved." />
                </StackPanel>

                <DockPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
                    <Button DockPanel.Dock="Right" Content="Send" Margin="8,0,0,0" Command="{Binding SendChatCommand}" />
                    <TextBox Margin="0" VerticalContentAlignment="Center"
                             MaxLength="{Binding MaxChatLength, Mode=OneTime}"
                             Text="{Binding ChatDraft, UpdateSourceTrigger=PropertyChanged}">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Enter" Command="{Binding SendChatCommand}" />
                        </TextBox.InputBindings>
                    </TextBox>
                </DockPanel>

                <Grid>
                    <TextBlock Text="No messages yet. Say hi!" Margin="0,8,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource Muted}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Chat.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <ScrollViewer x:Name="ChatScroller" VerticalScrollBarVisibility="Auto" ScrollChanged="OnChatScrollChanged">
                        <ItemsControl ItemsSource="{Binding Chat}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,4">
                                        <TextBlock Text="{Binding Sender}" FontWeight="SemiBold" FontSize="12">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsLocal}" Value="True">
                                                            <Setter Property="Foreground" Value="{StaticResource Accent}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Text="{Binding Text}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
