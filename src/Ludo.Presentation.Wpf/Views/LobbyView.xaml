<UserControl x:Class="Ludo.Presentation.Wpf.Views.LobbyView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:Ludo.Presentation.Wpf.Views">
    <UserControl.Resources>
        <Style x:Key="HiddenWhileRenaming" TargetType="FrameworkElement">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsRenaming}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid MaxWidth="1180" Margin="24,20,24,40">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3*" />
            <ColumnDefinition Width="2*" MinWidth="320" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Margin="8,8,8,12">
            <TextBlock Text="Lobby" FontSize="30" FontWeight="Bold" />
            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                <Ellipse Width="8" Height="8" Fill="{StaticResource Success}" VerticalAlignment="Center" Margin="1,1,8,0"
                         views:Motion.Pulse="True" />
                <TextBlock Style="{StaticResource Muted}" Text="{Binding Status}" VerticalAlignment="Center" />
            </StackPanel>
        </StackPanel>

        <!-- Rename: inline editor instead of a dialog, so no extra window needs protecting. -->
        <Border Grid.Column="1" Margin="8,8,8,12" VerticalAlignment="Center" Padding="6" CornerRadius="14"
                Background="{StaticResource Surface}" BorderBrush="{StaticResource Border}" BorderThickness="1">
            <Grid>
                <DockPanel Style="{StaticResource HiddenWhileRenaming}">
                    <Button DockPanel.Dock="Right" Style="{StaticResource SecondaryButton}" Content="Rename" Padding="12,5" FontSize="13"
                            Command="{Binding RenameCommand}" />
                    <Grid DockPanel.Dock="Left" Width="32" Height="32" Margin="2,0,10,0">
                        <Ellipse Fill="{StaticResource Accent}" />
                        <TextBlock Text="{Binding LocalName, Converter={x:Static views:InitialsConverter.Instance}}" FontSize="12"
                                   FontWeight="Bold" Foreground="{StaticResource AccentText}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                    <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                        <TextBlock Style="{StaticResource Overline}" Text="PLAYING AS" />
                        <TextBlock Text="{Binding LocalName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </DockPanel>
                <DockPanel Visibility="{Binding IsRenaming, Converter={StaticResource BoolToVisibility}}" views:Motion.Enter="True"
                           views:Motion.EnterOffset="4">
                    <Button DockPanel.Dock="Right" Style="{StaticResource SecondaryButton}" Content="Cancel" Margin="6,0,0,0"
                            Padding="12,5" FontSize="13" Command="{Binding CancelRenameCommand}" />
                    <Button DockPanel.Dock="Right" Content="Save" Margin="8,0,0,0" Padding="14,5" FontSize="13"
                            Command="{Binding SaveNameCommand}" />
                    <TextBox x:Name="NameBox" Margin="0" VerticalContentAlignment="Center" Tag="Your name"
                             MaxLength="{Binding MaxNameLength, Mode=OneTime}"
                             Text="{Binding NameDraft, UpdateSourceTrigger=PropertyChanged}"
                             IsVisibleChanged="OnNameBoxVisibleChanged">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Enter" Command="{Binding SaveNameCommand}" />
                            <KeyBinding Key="Escape" Command="{Binding CancelRenameCommand}" />
                        </TextBox.InputBindings>
                    </TextBox>
                </DockPanel>
            </Grid>
        </Border>

        <DockPanel Grid.Row="1">
            <!-- Anyone can start a game here; the card follows the invite from question to running game. -->
            <Grid DockPanel.Dock="Top" views:Motion.Enter="True">
                <!-- Breathing accent glow while an invite waits for our answer. -->
                <Border Margin="8" CornerRadius="14" BorderBrush="{StaticResource Accent}" BorderThickness="2"
                        Visibility="{Binding IsInvitedNow, Converter={StaticResource BoolToVisibility}}" views:Motion.Pulse="True">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="24" ShadowDepth="0" Opacity="0.8" Color="{StaticResource AccentColor}" />
                    </Border.Effect>
                </Border>
                <Border>
                    <Border.Style>
                        <Style TargetType="Border" BasedOn="{StaticResource Card}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsInvitedNow}" Value="True">
                                    <Setter Property="BorderBrush" Value="Transparent" />
                                    <Setter Property="Background" Value="#2A2619" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <DockPanel>
                        <!-- Dice badge. -->
                        <Border DockPanel.Dock="Left" Width="52" Height="52" CornerRadius="14" Margin="0,0,16,0" VerticalAlignment="Top"
                                Background="{StaticResource AccentSoft}">
                            <Grid Width="26" Height="26">
                                <Rectangle RadiusX="6" RadiusY="6" Fill="{StaticResource Accent}" />
                                <Ellipse Width="5" Height="5" Fill="{StaticResource AccentText}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="5" />
                                <Ellipse Width="5" Height="5" Fill="{StaticResource AccentText}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                <Ellipse Width="5" Height="5" Fill="{StaticResource AccentText}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="5" />
                            </Grid>
                        </Border>
                        <StackPanel>
                            <TextBlock Style="{StaticResource Heading}" Text="{Binding GameTitle}" Margin="0,0,0,4" TextWrapping="Wrap" />
                            <TextBlock Style="{StaticResource Muted}" Text="{Binding GameDetail}" TextWrapping="Wrap" />

                            <ItemsControl ItemsSource="{Binding Invitees}" Margin="0,12,0,0">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="14" Padding="10,4" Margin="0,0,6,6" BorderThickness="1">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="{StaticResource SurfaceRaised}" />
                                                    <Setter Property="BorderBrush" Value="{StaticResource Border}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsIn}" Value="True">
                                                            <Setter Property="Background" Value="{StaticResource SuccessSoft}" />
                                                            <Setter Property="BorderBrush" Value="#557BD88F" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock FontSize="13">
                                                <Run Text="{Binding Name, Mode=OneWay}" />
                                                <Run Text="{Binding Answer, Mode=OneWay}" FontWeight="SemiBold">
                                                    <Run.Style>
                                                        <Style TargetType="Run">
                                                            <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsIn}" Value="True">
                                                                    <Setter Property="Foreground" Value="{StaticResource Success}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Run.Style>
                                                </Run>
                                            </TextBlock>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <WrapPanel Margin="-4,6,0,0">
                                <Button Margin="4" Content="Start a game" Command="{Binding ProposeCommand}"
                                        Visibility="{Binding ShowPropose, Converter={StaticResource BoolToVisibility}}" />
                                <Button Margin="4" Content="{Binding BeginLabel}" Command="{Binding BeginCommand}"
                                        Visibility="{Binding ShowBegin, Converter={StaticResource BoolToVisibility}}" />
                                <Button Margin="4" Content="Join game" Command="{Binding AcceptCommand}"
                                        Visibility="{Binding ShowAccept, Converter={StaticResource BoolToVisibility}}" />
                                <Button Margin="4" Style="{StaticResource SecondaryButton}" Content="Not now" Command="{Binding DeclineCommand}"
                                        Visibility="{Binding IsInvitedNow, Converter={StaticResource BoolToVisibility}}" />
                                <Button Margin="4" Style="{StaticResource SecondaryButton}" Content="Back out" Command="{Binding DeclineCommand}"
                                        Visibility="{Binding ShowDecline, Converter={StaticResource BoolToVisibility}}" />
                                <Button Margin="4" Content="{Binding WatchLabel}" Command="{Binding WatchCommand}"
                                        Visibility="{Binding ShowWatch, Converter={StaticResource BoolToVisibility}}" />
                                <Button Margin="4" Style="{StaticResource SecondaryButton}" Content="Cancel invite" Command="{Binding StopCommand}"
                                        Visibility="{Binding ShowCancel, Converter={StaticResource BoolToVisibility}}" />
                                <Button Margin="4" Style="{StaticResource SecondaryButton}" Content="Stop game" Command="{Binding StopCommand}"
                                        Visibility="{Binding ShowStop, Converter={StaticResource BoolToVisibility}}" />
                            </WrapPanel>
                        </StackPanel>
                    </DockPanel>
                </Border>
            </Grid>

            <Border Style="{StaticResource Card}" views:Motion.Enter="True">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                        <Border DockPanel.Dock="Right" CornerRadius="10" Padding="9,2" Background="{StaticResource SurfaceRaised}"
                                VerticalAlignment="Center">
                            <TextBlock Text="{Binding MemberCount}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextMuted}" />
                        </Border>
                        <TextBlock Style="{StaticResource Heading}" Text="Players" Margin="0" />
                    </DockPanel>
                    <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource Muted}" FontSize="12" Margin="2,10,0,0" TextWrapping="Wrap"
                               Foreground="{StaticResource TextFaint}"
                               Text="Everyone who opens DiceDrop on this network lands here automatically. Allow DiceDrop through Windows Firewall when asked." />
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Members}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border x:Name="Row" CornerRadius="10" Padding="10,8" Margin="0,2" Background="Transparent">
                                        <DockPanel>
                                            <Grid DockPanel.Dock="Left" Width="34" Height="34" Margin="0,0,12,0">
                                                <Ellipse Fill="{Binding AvatarColor}" />
                                                <TextBlock Text="{Binding Initials}" FontSize="12" FontWeight="Bold" Foreground="White"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                <!-- Presence dot: green when connected to everyone, amber while still connecting. -->
                                                <Ellipse x:Name="Presence" Width="11" Height="11" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                                         Margin="0,0,-1,-1" Stroke="{StaticResource Surface}" StrokeThickness="2"
                                                         Fill="{StaticResource Accent}" />
                                            </Grid>
                                            <TextBlock x:Name="State" DockPanel.Dock="Right" VerticalAlignment="Center" Style="{StaticResource Muted}"
                                                       FontSize="12" Text="Connecting…" />
                                            <Border DockPanel.Dock="Right" Margin="0,0,10,0" Padding="8,2" CornerRadius="9"
                                                    Background="{StaticResource SuccessSoft}" VerticalAlignment="Center"
                                                    Visibility="{Binding InGame, Converter={StaticResource BoolToVisibility}}">
                                                <TextBlock Text="in game" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Success}" />
                                            </Border>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Style="{StaticResource Muted}" FontSize="12" Text="{Binding Tags}" x:Name="TagLine" />
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsReady}" Value="True">
                                            <Setter TargetName="Presence" Property="Fill" Value="{StaticResource Success}" />
                                            <Setter TargetName="State" Property="Text" Value="Ready" />
                                            <Setter TargetName="State" Property="Foreground" Value="{StaticResource Success}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Tags}" Value="">
                                            <Setter TargetName="TagLine" Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                        <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Row" Property="Background" Value="{StaticResource SurfaceRaised}" />
                                        </Trigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </DockPanel>

        <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource Card}" views:Motion.Enter="True">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,4">
                    <Border DockPanel.Dock="Right" CornerRadius="10" Padding="9,2" Background="{StaticResource SurfaceRaised}"
                            VerticalAlignment="Center">
                        <TextBlock Text="not saved" FontSize="11" Foreground="{StaticResource TextFaint}" />
                    </Border>
                    <StackPanel>
                        <TextBlock Style="{StaticResource Heading}" Text="Chat" Margin="0" />
                        <TextBlock Style="{StaticResource Muted}" FontSize="12" Text="Everyone in the lobby sees this." />
                    </StackPanel>
                </DockPanel>
                <Border DockPanel.Dock="Top" Height="1" Background="{StaticResource Border}" Margin="-18,10,-18,0" />
                <views:ChatPanel />
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
